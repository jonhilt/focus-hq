{
  "name": "focus",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "A cartoon 3D starship where a swarm of Claude Code agents works your GitHub issues.",
  "scripts": {
    "dev": "tsx server/supervise.ts --dev",
    "demo": "tsx server/index.ts --dev --demo",
    "demo:start": "tsx tools/demoServer.ts start",
    "demo:stop": "tsx tools/demoServer.ts stop",
    "demo:status": "tsx tools/demoServer.ts status",
    "build": "vite build",
    "start": "tsx server/supervise.ts",
    "typecheck": "tsc -p . && effect-language-service diagnostics --project tsconfig.json --format text",
    "lint": "eslint .",
    "test": "vitest run",
    "test:repeat": "tsx tools/repeatTests.ts",
    "smoke": "tsx tools/smoke.ts",
    "perf": "tsx tools/perf.ts",
    "scale": "tsx tools/scale.ts",
    "record-flows": "tsx tools/flows.ts",
    "zfight": "tsx tools/zfight.ts",
    "gaps": "tsx tools/gaps.ts",
    "ship": "tsx tools/ship.ts",
    "crap": "tsx plugins/scorecard/scripts/crap.ts",
    "rules": "tsx plugins/scorecard/scripts/rules.ts",
    "scorecard": "tsx plugins/scorecard/scripts/scorecard.ts",
    "climb:replay": "tsx plugins/climber/scripts/climbReplay.ts",
    "flow": "tsx plugins/flow/scripts/flow.ts",
    "qa-catch": "tsx tools/qaCatch.ts",
    "before-after": "tsx plugins/flow/scripts/beforeAfter.ts",
    "bug-corpus": "tsx tools/bugCorpus.ts",
    "bug-replay": "tsx tools/bugReplay.ts",
    "card-replay": "tsx plugins/chief-of-staff/scripts/cardReplay.ts",
    "jev-backtest": "tsx plugins/chief-of-staff/scripts/jevBacktest.ts",
    "jev-sweep": "tsx plugins/chief-of-staff/scripts/jevSweep.ts",
    "jev-fresh": "tsx plugins/chief-of-staff/scripts/jevFresh.ts",
    "jev-watch": "tsx plugins/chief-of-staff/scripts/jevWatch.ts",
    "fence:lower": "tsx plugins/scorecard/scripts/fenceLower.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.289",
    "@huggingface/transformers": "^3.8.1",
    "agent-host": "git+https://github.com/jonhilt/agent-host.git",
    "croner": "10.0.1",
    "dompurify": "^3.4.16",
    "effect": "4.0.6",
    "elkjs": "^0.12.0",
    "express": "^5.2.1",
    "kokoro-js": "^1.2.1",
    "marked": "^18.1.0",
    "playwright": "^1.63.0",
    "three": "^0.186.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "ws": "^8.22.0",
    "xstate": "5.33.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@effect/language-service": "0.87.3",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "^10.12.0",
    "fast-check": "^4.10.2",
    "happy-dom": "^20.14.5",
    "tailwindcss": "4.3.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@10.30.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "onnxruntime-node",
      "sharp"
    ],
    "ignoredBuiltDependencies": [
      "protobufjs"
    ]
  }
}
