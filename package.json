    "dompurify": "^3.4.16",
    "effect": "4.0.1",
    "express": "^5.2.1",
    "kokoro-js": "^1.2.1",
    "marked": "^18.1.0",
    "playwright": "^1.63.0",
    "three": "^0.186.1",
    "tsx": "^4.23.15",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@effect/language-service": "0.87.3",
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
