{
  "name": "focus",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "description": "A cartoon 3D office where a swarm of Claude Code agents works your GitHub issues.",
  "scripts": {
    "dev": "tsx server/supervise.ts --dev",
    "demo": "tsx server/index.ts --dev --demo",
    "demo:start": "tsx scripts/demoServer.ts start",
    "demo:stop": "tsx scripts/demoServer.ts stop",
    "demo:status": "tsx scripts/demoServer.ts status",
    "build": "vite build",
    "start": "tsx server/supervise.ts",
    "typecheck": "tsc -p . && effect-language-service diagnostics --project tsconfig.json --format text",
    "lint": "eslint .",
    "test": "vitest run",
    "test:repeat": "tsx scripts/repeatTests.ts",
    "smoke": "tsx scripts/smoke.ts",
    "perf": "tsx scripts/perf.ts",
    "studio": "tsx scripts/studio.ts",
    "zfight": "tsx scripts/zfight.ts",
    "gaps": "tsx scripts/gaps.ts",
    "ship": "tsx scripts/ship.ts",
    "crap": "tsx plugins/scorecard/scripts/crap.ts",
    "scorecard": "tsx plugins/scorecard/scripts/scorecard.ts",
    "climb:replay": "tsx plugins/climber/scripts/climbReplay.ts",
    "flow": "tsx scripts/flow.ts",
    "qa-catch": "tsx scripts/qaCatch.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.289",
    "@huggingface/transformers": "^3.8.1",
    "dompurify": "^3.4.16",
    "effect": "4.0.1",
    "express": "^5.2.1",
    "kokoro-js": "^1.2.1",
    "marked": "^18.1.0",
    "playwright": "^1.63.0",
    "three": "^0.186.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "ws": "^8.22.0",
    "xstate": "5.33.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@effect/language-service": "0.87.3",
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "^10.12.0",
    "happy-dom": "^20.14.5",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@10.30.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "onnxruntime-node",
      "sharp"
    ],
    "ignoredBuiltDependencies": [
      "protobufjs"
    ]
  }
}
