# The office's environment on this machine (systemd reads it: see docs/configuration.md for the rest).

# Agents' Claude login: a long-lived token from `claude setup-token` (your subscription, like on your Mac).
CLAUDE_CODE_OAUTH_TOKEN=
# Or put them on an API key instead:
# FOCUS_USE_API_KEY=1
# ANTHROPIC_API_KEY=

# Plugins to switch on, as on your Mac.
# FOCUS_PLUGINS=

# Nightly backups (deploy/vps/backup.sh) also go here with rsync, off this machine: your Mac, a NAS.
# FOCUS_BACKUP_TARGET=mac:Backups/focus/
# FOCUS_BACKUP_KEEP=14

# Stay on loopback: Tailscale Serve is the way in (https://<machine>.<tailnet>.ts.net).
HOST=127.0.0.1
PORT=4477
